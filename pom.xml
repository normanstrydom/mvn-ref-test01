<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.devtest</groupId>
  <artifactId>mvn-ref-test01</artifactId>
  <version>1.0.4-SNAPSHOT</version>
  <packaging>pom</packaging>

  <properties>
    <github.packages.url>https://maven.pkg.github.com/normanstrydom/${project.artifactId}</github.packages.url>
  </properties>

  <scm>
    <connection>scm:git:https://github.com/normanstrydom/${project.artifactId}.git</connection>
    <developerConnection>scm:git:https://github.com/normanstrydom/${project.artifactId}.git</developerConnection>
    <url>https://github.com/normanstrydom/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>${github.packages.url}</url>
    </repository>
  </distributionManagement>

  <modules>
    <module>mathfcns</module>
    <module>stringfcns</module>
    <module>bom</module>
  </modules>

</project>
