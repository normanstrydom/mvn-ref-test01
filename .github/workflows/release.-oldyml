name: Release to GitHub Packages

on:
  workflow_dispatch:
    inputs:
      releaseVersion:
        description: "Release version (example: 1.0.0-Final)"
        required: true
      nextSnapshotVersion:
        description: "Next development version without -SNAPSHOT (example: 1.0.1)"
        required: true

permissions:
  contents: write
  packages: write

jobs:
  release:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Configure Maven settings for GitHub Packages
        run: |
          cat > "$RUNNER_TEMP/settings.xml" << 'EOF'
          <settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
            <servers>
              <server>
                <id>github</id>
                <username>${env.GITHUB_ACTOR}</username>
                <password>${env.GITHUB_TOKEN}</password>
              </server>
            </servers>
          </settings>
          EOF
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Configure Git identity
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

      - name: Set release version in all modules
        run: |
          mvn -B -ntp versions:set -DnewVersion=${{ inputs.releaseVersion }} -DgenerateBackupPoms=false -DprocessAllModules=true
          git commit -am "Release ${{ inputs.releaseVersion }}"

      - name: Deploy released artifacts to GitHub Packages
        run: |
          mvn -B -ntp -s "$RUNNER_TEMP/settings.xml" -Dgithub.packages.url=https://maven.pkg.github.com/${{ github.repository }} clean deploy
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Create and push release tag
        run: |
          git tag -a v${{ inputs.releaseVersion }} -m "Release ${{ inputs.releaseVersion }}"
          git push origin HEAD
          git push origin v${{ inputs.releaseVersion }}

      - name: Bump to next snapshot version
        run: |
          mvn -B -ntp versions:set -DnewVersion=${{ inputs.nextSnapshotVersion }}-SNAPSHOT -DgenerateBackupPoms=false -DprocessAllModules=true
          git commit -am "Bump to ${{ inputs.nextSnapshotVersion }}-SNAPSHOT"
          git push origin HEAD
